{
  "name": "activeengagement/laravel-telemetry",
  "description": "Shared OpenTelemetry setup for AE Laravel apps",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "illuminate/auth": "^12.0|^13.30",
    "illuminate/bus": "^12.0|^13.30",
    "illuminate/console": "^12.0|^13.30",
    "illuminate/contracts": "^12.0|^13.30",
    "illuminate/log": "^12.0|^13.30",
    "illuminate/queue": "^12.0|^13.30",
    "illuminate/support": "^12.0|^13.30",
    "keepsuit/laravel-opentelemetry": "^2.2.4",
    "nesbot/carbon": "^3.0",
    "open-telemetry/api": "^1.8"
  },
  "require-dev": {
    "driftingly/rector-laravel": "^2.6",
    "larastan/larastan": "^3.13",
    "laravel/ai": "^1.3",
    "laravel/horizon": "^5.50",
    "laravel/pint": "^1.32",
    "orchestra/testbench": "^10.0|^11.0",
    "pestphp/pest": "^4.0",
    "phpstan/phpstan": "^2.3",
    "rector/rector": "^2.7"
  },
  "conflict": {
    "laravel/ai": "<1.3"
  },
  "autoload": {
    "psr-4": {
      "ActiveEngagement\\Telemetry\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ActiveEngagement\\Telemetry\\TelemetryServiceProvider"
      ]
    }
  },
  "scripts": {
    "lint": [
      "@php vendor/bin/rector",
      "@php vendor/bin/pint --parallel"
    ],
    "test:lint": [
      "@php vendor/bin/pint --parallel --test",
      "@php vendor/bin/rector --dry-run",
      "bin/changelog check"
    ],
    "test:types": "@php vendor/bin/phpstan",
    "test:unit": "@php vendor/bin/pest",
    "test": [
      "@test:unit",
      "@test:lint",
      "@test:types"
    ],
    "qa": [
      "@lint",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "suggest": {
    "laravel/ai": "Required for AI tracing (^1.3).",
    "laravel/horizon": "Required for the horizon queue heartbeat (^5.50)."
  }
}
