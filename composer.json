{
  "name": "actengage/laravel-telemetry",
  "description": "Shared OpenTelemetry setup for AE Laravel apps",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "illuminate/auth": "^12.0|^13.0",
    "illuminate/bus": "^12.0|^13.0",
    "illuminate/console": "^12.0|^13.0",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/log": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0",
    "keepsuit/laravel-opentelemetry": "^2.2.4",
    "nesbot/carbon": "^3.0",
    "open-telemetry/api": "^1.8"
  },
  "require-dev": {
    "driftingly/rector-laravel": "^2.6",
    "laravel/horizon": "^5.50",
    "orchestra/testbench": "^10.0|^11.0",
    "pestphp/pest": "^4.0",
    "phpstan/phpstan": "^2.3",
    "rector/rector": "^2.7"
  },
  "autoload": {
    "psr-4": {
      "Actengage\\Telemetry\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Actengage\\Telemetry\\TelemetryServiceProvider"
      ]
    }
  },
  "scripts": {
    "refactor": "rector",
    "test": "pest",
    "test:refactor": "rector --dry-run",
    "test:types": "phpstan"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "suggest": {
    "laravel/horizon": "Required for the horizon queue heartbeat (^5.50)."
  }
}
